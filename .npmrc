# @salvadorsc/quinipolo-shared is published to GitHub Packages (same package quinipolo-fe uses).
# npm expands ${NPM_TOKEN} from the environment. Do not commit a token.
# EAS Build reads this file during install. Create the secret before building:
#   eas env:set --name NPM_TOKEN --value <github_pat> --environment production --visibility secret
#   eas env:set --name NPM_TOKEN --value <github_pat> --environment preview --visibility secret
#   eas env:set --name NPM_TOKEN --value <github_pat> --environment development --visibility secret
# The PAT needs the read:packages scope (and SSO authorization if the org requires it).
@salvadorsc:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
