# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# API Configuration
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Environment
NODE_ENV=development

# GitHub Packages token for @salvadorsc/quinipolo-shared (classic PAT, read:packages).
# Export this in the shell before npm ci. npm does not load .env when expanding .npmrc.
# EAS cloud builds need the same value as a secret named NPM_TOKEN on the
# development, preview, and production environments. See the pull request notes.
NPM_TOKEN=
